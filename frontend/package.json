{
  "name": "frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "dev": "node api.js && next dev",
    "build": "node api.js && next build",
    "start": "node api.js && next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "tokens:build": "node scripts/generate-design-tokens.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "test:pact": "jest --config jest.config.ts --runTestsByPath tests/pact/trades.pact.spec.ts --runInBand",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "analyze": "ANALYZE=true next build",
    "bundle:check": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@stellar/freighter-api": "6.0.1",
    "@stellar/stellar-sdk": "17.1.0",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.6",
    "@pact-foundation/pact": "17.1.4",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "axe-core": "4.13.0",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "fast-check": "4.10.2",
    "jest": "30.5.2",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "30.5.2",
    "tailwindcss": "4.3.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "undici": "^8.11.2"
  }
}
