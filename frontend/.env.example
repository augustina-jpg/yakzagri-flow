# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment variables
#
# Copy to `.env.local` and fill in values. Only variables prefixed with
# NEXT_PUBLIC_ are exposed to the browser bundle — never put secrets there.
#
# Every NEXT_PUBLIC_* variable referenced via process.env in src/ MUST be
# declared here. CI enforces this via scripts/check-env-example.mjs.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────────────────────
# Base URL of the backend API. Read by src/lib/api/env.ts (API_BASE_URL) and
# src/app/api/flags/route.ts (BACKEND_URL). This is the canonical name.
# Default: http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Legacy alias for NEXT_PUBLIC_API_BASE_URL. src/lib/api/env.ts falls back to
# this when NEXT_PUBLIC_API_BASE_URL is unset. Prefer NEXT_PUBLIC_API_BASE_URL.
# Default: (unset)
NEXT_PUBLIC_API_URL=

# ── Stellar network ──────────────────────────────────────────────────────────
# Network selector — NOT a passphrase. Accepted values: testnet | mainnet |
# futurenet. Read by src/lib/api/env.ts to pick the network + default RPC.
# Default: testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_CONTRACT_ID=
# Stellar issuer address for Nigerian Naira (NGN) token.
# Must be a valid Stellar public key (starting with G, 56 characters).
# Required for payment operations involving NGN.
NEXT_PUBLIC_NGN_ISSUER=
NEXT_PUBLIC_FREIGHTER_ENABLED=true
# Version prefix for consumer-facing API calls. Leave as /api/v1 to use the
# versioned backend lane. Set empty (NEXT_PUBLIC_API_VERSION_PREFIX=) to fall
# back to the legacy unversioned aliases (deprecated).
NEXT_PUBLIC_API_VERSION_PREFIX=/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated Stellar public keys allowed to see admin UI (role badge, audit history panel).
# Should match the backend's ADMIN_STELLAR_PUBKEYS allowlist.
NEXT_PUBLIC_ADMIN_WALLETS=

# Albedo wallet connect URL. Read by src/lib/api/env.ts (ALBEDO_URL).
# Default: https://albedo.link
NEXT_PUBLIC_ALBEDO_URL=https://albedo.link

# ── App environment ──────────────────────────────────────────────────────────
# Runtime environment label. Accepted values: development | staging |
# production. Read by src/lib/api/env.ts (APP_ENV).
# Default: development
NEXT_PUBLIC_APP_ENV=development

# ── Feature flags ────────────────────────────────────────────────────────────
# Per-flag overrides. Read by src/app/api/flags/route.ts, which maps each flag
# name to NEXT_PUBLIC_ENABLE_<FLAG_NAME> (SCREAMING_SNAKE_CASE). Backend values
# from /api/admin/features take precedence; these are the fallback.
# Accepted values: true | false. Default: catalog default in src/lib/featureFlags.ts
#
# NEXT_PUBLIC_ENABLE_<FLAG_NAME>=true

# ── Pinata (IPFS uploads) ────────────────────────────────────────────────────
# Only NEXT_PUBLIC_-prefixed vars are inlined into the browser bundle by
# Next.js. The Pinata JWT is a secret and MUST NOT be exposed client-side, so
# it is read server-side only (no NEXT_PUBLIC_ prefix) by the upload proxy
# route at src/app/api/pinata/route.ts. VideoUploadCard posts to that route
# instead of calling Pinata directly.
#
# Server-only secret — never prefix with NEXT_PUBLIC_.
# Default: (unset — uploads disabled)
PINATA_JWT=

# Optional public gateway used to build display URLs for uploaded CIDs.
# Safe to expose; read client-side by VideoUploadCard.
# Default: https://gateway.pinata.cloud
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud
