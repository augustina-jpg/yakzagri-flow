#!/bin/sh
# Pre-commit hook: lint and typecheck staged frontend files.
# Runs eslint on staged JS/JSX/TS/TSX files under frontend/ and
# tsc --noEmit for typechecking. Skips cleanly when nothing relevant is staged.

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
FRONTEND_DIR="$REPO_ROOT/frontend"

# Collect staged files (added/copied/modified), excluding deletions.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Filter to frontend lintable files.
FRONTEND_LINTABLE=$(printf '%s\n' "$STAGED_FILES" \
  | grep -E '^frontend/.*\.(js|jsx|ts|tsx)$' || true)

# Filter to any staged frontend files (for typecheck trigger).
FRONTEND_ANY=$(printf '%s\n' "$STAGED_FILES" \
  | grep -E '^frontend/' || true)

if [ -z "$FRONTEND_ANY" ]; then
  # No frontend changes staged; nothing to do.
  exit 0
fi

if [ ! -d "$FRONTEND_DIR" ]; then
  echo "pre-commit: frontend/ directory not found, skipping frontend checks." >&2
  exit 0
fi

cd "$FRONTEND_DIR"

if [ -n "$FRONTEND_LINTABLE" ]; then
  # Strip the leading frontend/ prefix so paths are relative to frontend/.
  REL_FILES=$(printf '%s\n' "$FRONTEND_LINTABLE" | sed 's|^frontend/||')
  echo "pre-commit: running eslint on staged frontend files..." >&2
  # shellcheck disable=SC2086
  pnpm exec eslint $REL_FILES
fi

echo "pre-commit: running tsc --noEmit..." >&2
pnpm exec tsc --noEmit
